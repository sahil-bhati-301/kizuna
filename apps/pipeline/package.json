{
  "name": "@kizuna/pipeline",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore",
    "test": "vitest run",
    "sources:fetch": "node --experimental-strip-types src/sources/cli.ts fetch",
    "sources:pin": "node --experimental-strip-types src/sources/cli.ts pin",
    "jmdict:run": "node --experimental-strip-types src/import/jmdict-cli.ts",
    "kanjivg:bundle": "node --experimental-strip-types src/sources/kanjivg-bundle-cli.ts",
    "kanjivg:run": "node --experimental-strip-types src/import/kanjivg-cli.ts"
  },
  "dependencies": {
    "@kizuna/content": "workspace:*",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "fast-check": "^4.11.0"
  }
}
