    "test": "vitest run"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.2",
    "@types/pg": "^8.23.1",
    "testcontainers": "^12.2.2"
  }
